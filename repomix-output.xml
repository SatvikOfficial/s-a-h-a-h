  reporterName: string
  incidentType: 'intruder' | 'disturbance' | 'vandalism' | 'other'
  location: string
  latitude: number
  longitude: number
  date: string
  time: string
  description: string
  photos: string[]
  status: 'new' | 'reviewing' | 'acknowledged' | 'resolved'
